# The live judges' keys, two model families (config/judges-live.yaml). T-480, roadmap row N137.
# Their runtime home is the Worker secrets of holdback-op1, whose Durable Object runs the adjudicators.
# Rafa runs, in his own terminal:
#   op run --env-file=config/secrets/judges.refs -- pnpm demo-cloud:secrets   (pushes them to holdback-op1)
#   op run --env-file=config/secrets/judges.refs -- pnpm demo --live           (the local live demo)
# Today one key per family serves both jobs; row N137 gives the local demo keys of its own.
# Each line is a 1Password reference or plain configuration, never a value (tests/secrets-refs.test.ts).
HOLDBACK_ANTHROPIC_API_KEY=op://crow/op1-judges-anthropic/credential
HOLDBACK_OPENAI_COMPATIBLE_API_KEY=op://crow/op1-judges-deepseek/credential
HOLDBACK_OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
