# Optional: a Cloudflare API token for Wrangler in place of its own login, and the account ID it acts on.
# The account ID is not a secret; it stays out of this public repository all the same. T-480, row N137.
# Wrangler reads both variables. Rafa runs, for example:
#   op run --env-file=config/secrets/cloudflare.refs -- npx wrangler@4.151.3 whoami
CLOUDFLARE_API_TOKEN=op://crow/mac-cloudflare-token/credential
CLOUDFLARE_ACCOUNT_ID=op://crow/cloudflare-account-id/credential
