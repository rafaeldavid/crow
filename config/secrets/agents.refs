# The model keys of the agents that buy and sell in Crow's benchmarks, never the judges' keys. T-480, row N137.
# Used on Rafa's Mac only, by tools/duet (both vendors) and tools/one-click's live runs (Anthropic only):
#   op run --env-file=config/secrets/agents.refs -- pnpm duet run --scenario paid --buyer deepseek --seller claude
#   op run --env-file=config/secrets/agents.refs -- node tools/one-click/bench.mjs --scenario s1 --live
# Today the Anthropic key serves both tools; set a spend cap on each key at its provider.
HOLDBACK_AGENT_ANTHROPIC_API_KEY=op://crow/mac-agents-anthropic/credential
HOLDBACK_AGENT_OPENAI_COMPATIBLE_API_KEY=op://crow/mac-agents-deepseek/credential
HOLDBACK_AGENT_OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
