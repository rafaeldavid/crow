{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holdback.dev/schemas/v0.15/judgment.schema.json",
  "title": "Judgment record",
  "type": "object",
  "required": [
    "commitmentId",
    "attempt",
    "deliveryHash",
    "adjudicator",
    "role",
    "intake",
    "deterministic",
    "screen",
    "panel",
    "aggregate",
    "recordHash",
    "decidedAt",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "commitmentId": {
      "$ref": "common.schema.json#/$defs/Hex32"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "deliveryHash": {
      "$ref": "common.schema.json#/$defs/Hex32",
      "description": "EIP-712 struct hash of the seller-signed delivery judged. recordHash covers it, so the decision's judgmentRecordHash binds it; it equals the decision's deliveryHash (ADR-0029)"
    },
    "adjudicator": {
      "$ref": "common.schema.json#/$defs/Address"
    },
    "role": {
      "enum": [
        "primary",
        "fallback",
        "appeal"
      ]
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plaintextHashVerified",
        "mime",
        "bytes",
        "normalized"
      ],
      "properties": {
        "plaintextHashVerified": {
          "type": "boolean"
        },
        "mime": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9.+-]{1,100}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "normalized": {
          "type": "boolean"
        }
      }
    },
    "deterministic": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkId",
          "required",
          "passed"
        ],
        "properties": {
          "checkId": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,40}$"
          },
          "required": {
            "type": "boolean"
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "maxLength": 300,
            "x-holdback-untrusted": true
          }
        }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flagged",
        "signals"
      ],
      "properties": {
        "flagged": {
          "type": "boolean"
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "instruction_phrase",
                  "encoded_run",
                  "unicode_tags",
                  "zero_width",
                  "canary_echo",
                  "classifier",
                  "nfkc_changed",
                  "variation_selector_run",
                  "mixed_script",
                  "hidden_characters"
                ],
                "description": "Closed set (ADR-0021): instruction_phrase, encoded_run, unicode_tags, zero_width, canary_echo, classifier, nfkc_changed, variation_selector_run, mixed_script, hidden_characters"
              },
              "detail": {
                "type": "string",
                "maxLength": 300,
                "x-holdback-untrusted": true
              }
            }
          }
        }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ran",
        "policyId",
        "policyHash",
        "members",
        "seedSource"
      ],
      "properties": {
        "ran": {
          "type": "boolean"
        },
        "policyId": {
          "type": "string",
          "x-holdback-untrusted": true,
          "maxLength": 120
        },
        "policyHash": {
          "$ref": "common.schema.json#/$defs/Hex32",
          "description": "Must equal the commitment's adjudication.policyHash"
        },
        "seedCommitment": {
          "$ref": "common.schema.json#/$defs/Hex32",
          "description": "keccak256(seed) from the primary's acceptance; commit-reveal panels only"
        },
        "seed": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "judgeId",
              "provider",
              "family",
              "model",
              "promptTemplateHash",
              "inputHash",
              "rubricHash",
              "status"
            ],
            "properties": {
              "judgeId": {
                "$ref": "common.schema.json#/$defs/Ident"
              },
              "provider": {
                "$ref": "common.schema.json#/$defs/Ident"
              },
              "family": {
                "$ref": "common.schema.json#/$defs/Ident"
              },
              "model": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:/@-]{1,128}$",
                "not": {
                  "type": "string",
                  "pattern": "[Ll][Aa][Tt][Ee][Ss][Tt]"
                },
                "description": "Pinned model ID; floating aliases such as 'latest' are rejected"
              },
              "promptTemplateHash": {
                "$ref": "common.schema.json#/$defs/Hex32",
                "description": "SHA-256 of the fixed template; must match the policy bound by policyHash"
              },
              "inputHash": {
                "$ref": "common.schema.json#/$defs/Hex32",
                "description": "SHA-256 of the full rendered prompt (template plus spec, seeded criteria order and spotlighted deliverable data). Recomputable by anyone holding the plaintext"
              },
              "rubricHash": {
                "$ref": "common.schema.json#/$defs/Hex32"
              },
              "latencyMs": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "enum": [
                  "ok",
                  "abstain",
                  "timeout",
                  "error",
                  "recorded"
                ]
              },
              "verdict": {
                "description": "The seat's verdict in the format its bound policy names (ADR-0050). A prose verdict (template pairs 1 and 2) carries no format key and is the judge's output after the filter. A coded verdict (template pair 3, agg-6) carries format coded-1, the scores, reason codes and injection kinds, an anchor for each reference that resolved in the work, and the counts of what the filter dropped; no judge-written string.",
                "oneOf": [
                  {
                    "$ref": "judge-verdict.schema.json#/$defs/ProseVerdict"
                  },
                  {
                    "$ref": "#/$defs/CodedRecordVerdict"
                  }
                ]
              }
            }
          }
        },
        "seedSource": {
          "enum": [
            "commit-reveal",
            "beacon"
          ],
          "description": "commit-reveal for the primary; beacon for fallback and appeal panels (ADR-0018)"
        },
        "beaconRound": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "seedSource": {
                "const": "commit-reveal"
              }
            },
            "type": "object",
            "required": [
              "seedSource"
            ]
          },
          "then": {
            "required": [
              "seedCommitment"
            ],
            "type": "object",
            "properties": {
              "seedCommitment": {}
            }
          }
        },
        {
          "if": {
            "properties": {
              "seedSource": {
                "const": "beacon"
              }
            },
            "type": "object",
            "required": [
              "seedSource"
            ]
          },
          "then": {
            "required": [
              "beaconRound"
            ],
            "type": "object",
            "properties": {
              "beaconRound": {}
            }
          }
        }
      ]
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reasons"
      ],
      "properties": {
        "decision": {
          "enum": [
            "accept",
            "reject",
            "escalate"
          ]
        },
        "weightedScore": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 400,
          "description": "Mean weighted score in hundredths of a rubric point, or null when no verdict was valid"
        },
        "passCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Valid verdicts that passed"
        },
        "failCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Valid verdicts that failed"
        },
        "validCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Valid verdicts"
        },
        "passFamilies": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Ident"
          }
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 200,
            "x-holdback-untrusted": true
          }
        }
      }
    },
    "recordUri": {
      "type": "string",
      "format": "uri",
      "x-holdback-untrusted": true,
      "maxLength": 2048
    },
    "recordHash": {
      "$ref": "common.schema.json#/$defs/Hex32"
    },
    "decidedAt": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/Signature"
    },
    "privateRecord": {
      "$ref": "common.schema.json#/$defs/PrivateBody",
      "description": "The full record kept off the public log when disclosure is private (ADR-0020)"
    }
  },
  "$defs": {
    "Anchor": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "The first 8 bytes of HMAC-SHA-256 over the locator, keyed by SHA-256 of the domain tag holdback/judgment/anchor/v1 and the work's plaintext, as 16 lowercase hex characters (ADR-0050 section 3). Only a holder of the work can match it to a node or a line."
    },
    "CodedRecordVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "criteria",
        "overall",
        "injectionSuspected",
        "injectionKinds",
        "injectionRefs",
        "dropped"
      ],
      "properties": {
        "format": {
          "const": "coded-1"
        },
        "criteria": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "refs",
              "reasons",
              "score"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,40}$"
              },
              "refs": {
                "type": "array",
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/Anchor"
                }
              },
              "reasons": {
                "type": "array",
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "$ref": "judge-verdict.schema.json#/$defs/ReasonCode"
                }
              },
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            }
          }
        },
        "overall": {
          "enum": [
            "pass",
            "fail",
            "abstain"
          ]
        },
        "injectionSuspected": {
          "type": "boolean"
        },
        "injectionKinds": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "judge-verdict.schema.json#/$defs/InjectionKind"
          }
        },
        "injectionRefs": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Anchor"
          }
        },
        "dropped": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reasons",
            "refs",
            "keys"
          ],
          "description": "What the filter dropped from the judge's output, each count capped at 9: reasons counts reason codes and injection kinds; refs counts references; keys counts unknown keys (ADR-0050 section 2). Never an escalation reason.",
          "properties": {
            "reasons": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "refs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "keys": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            }
          }
        }
      }
    }
  }
}
